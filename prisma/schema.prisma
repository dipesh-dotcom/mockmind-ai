generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  GITHUB
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  STAFF
}

enum InterviewType {
  VOICE
  TEXT
  CODING
  BEHAVIORAL
}

enum InterviewStatus {
  DRAFT
  GENERATING
  READY
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SuggestionPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String?
  provider      AuthProvider @default(CREDENTIALS)
  emailVerified DateTime?
  name          String
  avatarUrl     String?
  bio           String?
  targetRole    String?
  location      String?
  timezone      String?
  currentStreak Int          @default(0)
  longestStreak Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts   Account[]
  Session    Session[]
  resumes    Resume[]
  interviews Interview[]

  @@index([email])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Interview {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  jobTitle        String
  jobDescription  String?         @db.Text
  experienceLevel ExperienceLevel @default(MID)
  type            InterviewType   @default(BEHAVIORAL)
  durationMinutes Int             @default(30)
  focusAreas      String[]        @default([])

  status InterviewStatus @default(DRAFT)
  score  Int?

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id])

  questions InterviewQuestion[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

model InterviewQuestion {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  order          Int
  category       String?
  question       String   @db.Text
  expectedAnswer String?  @db.Text
  hints          String[] @default([])
  followUps      String[] @default([])

  answer InterviewAnswer?

  createdAt DateTime @default(now())

  @@index([interviewId])
}

model InterviewAnswer {
  id         String            @id @default(uuid())
  questionId String            @unique
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  transcript   String?  @db.Text
  score        Int?
  feedback     String?  @db.Text
  strengths    String[] @default([])
  improvements String[] @default([])

  createdAt DateTime @default(now())
}

model Resume {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  fileUrl     String
  rawText     String?  @db.Text
  isActive    Boolean  @default(true)
  atsScore    Int?
  resumeScore Int?
  uploadedAt  DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews  Interview[]
  keywords    ResumeKeyword[]
  skillGaps   ResumeSkillGap[]
  suggestions ResumeSuggestion[]

  @@index([userId, isActive])
}

model ResumeKeyword {
  id       String  @id @default(cuid())
  resumeId String
  keyword  String
  matched  Boolean

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeSkillGap {
  id         String             @id @default(cuid())
  resumeId   String
  skill      String
  importance SuggestionPriority
  note       String?

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeSuggestion {
  id       String             @id @default(cuid())
  resumeId String
  title    String
  detail   String
  priority SuggestionPriority

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}
